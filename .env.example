# Copy to .env and edit. Never commit .env.

# --- Database ---------------------------------------------------------------
# Default (if unset): SQLite file inside the Docker volume.
# Supabase: Project → Connect → "Session pooler" URI, pasted as-is:
# IRONLOG_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Accounts ---------------------------------------------------------------
# First account created becomes admin. After that: open | invite | closed
IRONLOG_SIGNUP_MODE=invite
IRONLOG_SESSION_DAYS=90

# --- Behind HTTPS (recommended) ---------------------------------------------
IRONLOG_COOKIE_SECURE=true
IRONLOG_TRUST_PROXY=true

# --- Exercise images --------------------------------------------------------
# Served from jsDelivr by default. To self-host them, run
#   docker compose exec ironlog python scripts/fetch_exercise_images.py /data/exercise-images
# then set:
# IRONLOG_EXERCISE_IMAGE_DIR=/data/exercise-images
